  "formulas": {
    "damage": {
      "formula": "max(1, floor(baseDamage * STAB * typeEff * levelGapMultiplier * critMultiplier * randomVariance))",
      "details": {
        "baseDamage": "(2 * attackerLevel / 5 + 2) * movePower * (isPhys ? Atk : SpA) / (isPhys ? Def : SpD) / 50 + 2",
        "STAB": "attackerTypes.includes(moveType) ? 1.5 : 1.0",
        "weatherMultiplier": "rain/sun/sand/snow damage boost (1.1x) or penalty (0.9x)",
        "levelGapMultiplier": "1.06 ** (attackerLevel - defenderLevel)",
        "critMultiplier": "isCrit ? 1.5 : 1.0",
        "randomVariance": "0.85 to 1.00 (linear uniform distribution)"
      }
    },
    "catchRate": {
      "formula": "P = min(CAPTURE_MAX * buff, (rate / 255) * CAPTURE_BONUS * buff)",
      "shakes": {
        "shakeProbability": "P ** 0.25",
        "shakesRolled": "for (let i = 0; i < 4 && Math.random() < shakeProb; i++) shakes++",
        "successCondition": "shakes === 4 (Master Ball or Roaming catch bypasses standard roll)"
      },
